# Copy to pipeline/.env or project root .env

# B-roll provider default: pixabay | unsplash (UI can override per video)
BROLL_PROVIDER=pixabay

# Pixabay API (default B-roll) — https://pixabay.com/api/docs/
PIXABAY_API_KEY=42676992-be0fd92692db479894d40b5ad

# Unsplash API (optional alternate) — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Path to Google OAuth client secrets JSON (YouTube Data API v3)
YOUTUBE_CLIENT_SECRETS=pipeline/client_secrets.json

# Where OAuth tokens are stored after first login
YOUTUBE_TOKEN_PATH=pipeline/token.json

# Content language: hi (Hindi) or en
LANGUAGE=hi

# edge-tts voice — Hindi defaults:
#   Male:   hi-IN-MadhurNeural
#   Female: hi-IN-SwaraNeural
# List all: edge-tts --list-voices
TTS_VOICE=hi-IN-MadhurNeural

# Output root for runs
OUTPUT_DIR=workspace/runs

# B-roll cache
CACHE_DIR=workspace/cache

# Default format: shorts (1080x1920) or long (1920x1080)
VIDEO_FORMAT=shorts

# Privacy used when uploading after "ship it": private | unlisted | public
UPLOAD_PRIVACY=private

# Optional brand colors for thumbnails (hex)
THUMB_BG=#0B1220
THUMB_FG=#F5F7FA
THUMB_ACCENT=#F5C542

# Optional ElevenLabs (unused in v1; edge-tts is default)
# ELEVENLABS_API_KEY=
